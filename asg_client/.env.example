# Prod backend connection settings
MENTRAOS_HOST=api.mentra.glass
MENTRAOS_PORT=443
MENTRAOS_SECURE=true

# Sentry error reporting (optional - crashes still logged locally without this)
SENTRY_DSN=

# Optional direct Cally connection over Wi-Fi. Keep real credentials in .env only.
CALLY_DIRECT_MODE=disabled
CALLY_DIRECT_URL=
CALLY_DIRECT_DEVICE_TOKEN=
CALLY_DIRECT_CF_ACCESS_CLIENT_ID=
CALLY_DIRECT_CF_ACCESS_CLIENT_SECRET=
CALLY_DIRECT_ALLOW_CLEARTEXT_DEBUG=false
