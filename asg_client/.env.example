# Prod backend connection settings
MENTRAOS_HOST=api.mentra.glass
MENTRAOS_PORT=443
MENTRAOS_SECURE=true

# Sentry error reporting (optional - crashes still logged locally without this)
SENTRY_DSN=

# Direct glasses -> Cally WebSocket POC (disabled unless explicitly enabled)
CALLY_DIRECT_MODE=disabled
CALLY_DIRECT_URL=
# Preferred edge authentication for a Cloudflare Access-protected endpoint.
CALLY_DIRECT_CF_ACCESS_CLIENT_ID=
CALLY_DIRECT_CF_ACCESS_CLIENT_SECRET=
# Temporary development fallback; optional when the Cloudflare pair is configured.
CALLY_DIRECT_DEVICE_TOKEN=
# Local debug builds only. Release builds reject ws:// even when this is true.
CALLY_DIRECT_ALLOW_CLEARTEXT_DEBUG=false
